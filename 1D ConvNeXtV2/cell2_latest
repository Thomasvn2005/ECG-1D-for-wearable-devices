# 5. VECTORIZED ECG AUGMENTATION
# PAPER SECTION 3.7
# ============================================================
def augment_batch(x,y):
    if not USE_AUGMENTATION:
        return x
    x=x.clone()
    b,c,l=x.shape
    device=x.device
    dtype=x.dtype
    # AMPLITUDE SCALING: p=0.75, factor 0.6 to 1.4
    mask=(torch.rand(b,device=device)<0.75)
    scale=0.6+0.8*torch.rand(b,device=device,dtype=dtype)
    scale=torch.where(mask,scale,torch.ones_like(scale))
    x=x*scale.view(b,1,1)
    # OFFSET: p=0.75, range -0.2 to 0.2
    mask=(torch.rand(b,device=device)<0.75)
    offset=(torch.rand(b,device=device,dtype=dtype)*0.4-0.2)*mask.to(dtype)
    x=x+offset.view(b,1,1)
    # GAUSSIAN, PINK, BROWN NOISE: p=0.75
    noise_mask=(torch.rand(b,device=device)<0.75)
    if noise_mask.any():
        raw_noise=torch.randn(b,l,device=device,dtype=dtype)
        noise_kind=torch.randint(0,3,(b,),device=device)
        spectrum=torch.fft.rfft(raw_noise,dim=-1)
        freq=torch.arange(spectrum.shape[-1],device=device,dtype=dtype).clamp(min=1.0)
        pink_scale=freq.pow(-0.5)
        brown_scale=freq.pow(-1.0)
        scale_matrix=torch.ones((b,spectrum.shape[-1]),device=device,dtype=dtype)
        scale_matrix=torch.where((noise_kind==1).view(b,1),pink_scale.view(1,-1),scale_matrix)
        scale_matrix=torch.where((noise_kind==2).view(b,1),brown_scale.view(1,-1),scale_matrix)
        noise=torch.fft.irfft(spectrum*scale_matrix,n=l,dim=-1)
        noise=noise/(noise.std(dim=-1,keepdim=True)+1e-6)
        amplitude=torch.rand(b,device=device,dtype=dtype)*0.4-0.2
        amplitude=amplitude*noise_mask.to(dtype)
        x=x+noise.unsqueeze(1)*amplitude.view(b,1,1)
    # TEMPORAL SHIFT: p=0.75, shift -625 to 625
    shift_mask=(torch.rand(b,device=device)<0.75)
    shifts=torch.randint(-625,626,(b,),device=device)
    shifts=shifts*shift_mask.to(shifts.dtype)
    positions=torch.arange(l,device=device).view(1,l)
    gather_indices=(positions-shifts.view(b,1))%l
    x=torch.gather(x,2,gather_indices.unsqueeze(1))
    # BASELINE WANDER: p=0.25
    # FREQUENCY AND AMPLITUDE BELOW ARE IMPLEMENTATION ASSUMPTIONS
    wander_mask=(torch.rand(b,device=device)<0.25)
    t=torch.arange(l,device=device,dtype=dtype)/125.0
    frequency=0.05+0.45*torch.rand(b,device=device,dtype=dtype)
    amplitude=0.2*torch.rand(b,device=device,dtype=dtype)
    phase=2.0*math.pi*torch.rand(b,device=device,dtype=dtype)
    baseline=amplitude.view(b,1)*torch.sin(2.0*math.pi*frequency.view(b,1)*t.view(1,l)+phase.view(b,1))
    x=x+baseline.unsqueeze(1)*wander_mask.to(dtype).view(b,1,1)
    # INVERT ECG POLARITY: p=0.20
    invert_mask=(torch.rand(b,device=device)<0.20)
    polarity=torch.where(invert_mask,-torch.ones(b,device=device,dtype=dtype),torch.ones(b,device=device,dtype=dtype))
    x=x*polarity.view(b,1,1)
    # ARTIFICIAL NOISE NEGATIVE EXAMPLES: p=0.05 FOR NON-AF
    artificial_mask=(y==0)&(torch.rand(b,device=device)<0.05)
    if artificial_mask.any():
        artificial_noise=torch.randn(b,1,l,device=device,dtype=dtype)
        artificial_noise=artificial_noise/(artificial_noise.std(dim=-1,keepdim=True)+1e-6)
        artificial_amplitude=0.05+0.25*torch.rand(b,1,1,device=device,dtype=dtype)
        x=torch.where(artificial_mask.view(b,1,1),artificial_noise*artificial_amplitude,x)
    return x
# ============================================================
# 6. TRAIN ONE EPOCH
# ============================================================
def train_one_epoch(model,loader,criterion,optimizer,device,epoch):
    model.train()
    running_loss=0.0
    correct=0
    total=0
    start=time.time()
    for batch_idx,(x,y) in enumerate(loader,1):
        x=x.to(device,non_blocking=True)
        y=y.to(device,non_blocking=True)
        x=augment_batch(x,y)
        optimizer.zero_grad(set_to_none=True)
        logits=model(x)
        loss=criterion(logits,y)
        loss.backward()
        optimizer.step()
        running_loss+=float(loss.item())*y.size(0)
        predictions=logits.argmax(dim=1)
        correct+=int((predictions==y).sum().item())
        total+=int(y.size(0))
        if batch_idx%25==0 or batch_idx==len(loader):
            print(f"\rEpoch {epoch} | Train {batch_idx}/{len(loader)} | Loss={running_loss/total:.5f} | Acc={correct/total:.4f}",end="",flush=True)
    print()
    return running_loss/total,correct/total,(time.time()-start)/60
# ============================================================
# 7. VALIDATION METRICS
# ============================================================
@torch.no_grad()
def validate(model,loader,criterion,device,description="VALIDATION"):
    model.eval()
    running_loss=0.0
    total=0
    all_true=[]
    all_prob=[]
    start=time.time()
    for batch_idx,(x,y) in enumerate(loader,1):
        x=x.to(device,non_blocking=True)
        y=y.to(device,non_blocking=True)
        logits=model(x)
        loss=criterion(logits,y)
        prob=torch.softmax(logits,dim=1)[:,1]
        running_loss+=float(loss.item())*y.size(0)
        total+=int(y.size(0))
        all_true.append(y.cpu().numpy())
        all_prob.append(prob.cpu().numpy())
        if batch_idx%500==0 or batch_idx==len(loader):
            print(f"\r{description}: {batch_idx}/{len(loader)}",end="",flush=True)
    print()
    y_true=np.concatenate(all_true)
    y_prob=np.concatenate(all_prob)
    y_pred=(y_prob>=0.5).astype(np.uint8)
    result={}
    result["loss"]=running_loss/total
    result["accuracy"]=float(accuracy_score(y_true,y_pred))
    result["precision"]=float(precision_score(y_true,y_pred,zero_division=0))
    result["recall"]=float(recall_score(y_true,y_pred,zero_division=0))
    result["f1"]=float(f1_score(y_true,y_pred,zero_division=0))
    result["auc"]=float(roc_auc_score(y_true,y_prob)) if len(np.unique(y_true))==2 else float("nan")
    result["prob_mean"]=float(np.mean(y_prob))
    result["prob_std"]=float(np.std(y_prob))
    result["predicted_af_percent"]=float(100*np.mean(y_pred))
    result["minutes"]=(time.time()-start)/60
    return result
